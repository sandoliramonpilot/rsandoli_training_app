{
  "name": "PilotChangeRequest",
  "type": "object",
  "properties": {
    "aircraftProfile": {
      "type": "string",
      "enum": [
        "AW119",
        "H125",
        "shared"
      ],
      "default": "AW119",
      "title": "Perfil da aeronave"
    },
    "pilot_id": {
      "type": "string",
      "title": "ID do piloto"
    },
    "pilot_name": {
      "type": "string",
      "title": "Nome do piloto"
    },
    "requested_by": {
      "type": "string",
      "title": "Solicitado por"
    },
    "changes": {
      "type": "string",
      "title": "Altera\u00e7\u00f5es (JSON)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "title": "Status"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Analisado por"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Data da an\u00e1lise"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o",
      "maxLength": 1000
    }
  },
  "required": [
    "pilot_id",
    "requested_by",
    "changes"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.requested_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}