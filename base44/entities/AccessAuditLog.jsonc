      "type": "string",
      "title": "Nome do respons\u00e1vel"
    },
    "target_user_id": {
      "type": "string",
      "title": "Usu\u00e1rio afetado"
    },
    "target_name": {
      "type": "string",
      "title": "Nome do usu\u00e1rio afetado"
    },
    "action": {
      "type": "string",
      "title": "Tipo da a\u00e7\u00e3o"
    },
    "details": {
