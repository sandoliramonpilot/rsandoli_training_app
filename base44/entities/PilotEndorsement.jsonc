{
  "name": "PilotEndorsement",
  "type": "object",
  "properties": {
    "pilot_id": {
      "type": "string",
      "title": "Piloto vinculado"
    },
    "pilot_name": {
      "type": "string",
      "title": "Nome do piloto (snapshot)"
    },
    "aircraft_model": {
      "type": "string",
      "title": "Modelo de aeronave"
    },
    "aircraft_model_label": {
      "type": "string",
      "title": "Modelo (r\u00f3tulo)"
    },
    "function": {
      "type": "string",
      "title": "Fun\u00e7\u00e3o autorizada"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "title": "Data de concess\u00e3o"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "title": "Data de validade"
    },
    "situation": {
      "type": "string",
      "enum": [
        "valid",
        "near_expiry",
        "expired",
        "suspended",
        "renewing",
        "pending",
        "na"
      ],
      "default": "pending",
      "title": "Situa\u00e7\u00e3o"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    },
    "document_uri": {
      "type": "string",
      "title": "URI do documento (privado)"
    },
    "document_name": {
      "type": "string",
      "title": "Nome do documento"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "rejected"
      ],
      "default": "draft",
      "title": "Status de aprova\u00e7\u00e3o"
    },
    "approval_log": {
      "type": "string",
      "title": "Log de aprova\u00e7\u00e3o (JSON)"
    }
  },
  "required": [
    "pilot_id",
    "aircraft_model"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}