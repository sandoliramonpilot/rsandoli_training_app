{
  "name": "Aircraft",
  "type": "object",
  "properties": {
    "aircraftProfile": {
      "type": "string",
      "enum": [
        "AW119",
        "H125",
        "shared"
      ],
      "default": "AW119",
      "title": "Perfil da aeronave"
    },
    "registration": {
      "type": "string",
      "title": "Matr\u00edcula",
      "description": "Ex: PR-ABC, PT-HXYZ"
    },
    "model": {
      "type": "string",
      "title": "Modelo",
      "description": "Ex: Bell 206, Robinson R44, AS350 \u00c9cureuil"
    },
    "manufacturer": {
      "type": "string",
      "title": "Fabricante"
    },
    "year": {
      "type": "integer",
      "title": "Ano"
    },
    "total_hours": {
      "type": "number",
      "title": "Total de horas de voo",
      "default": 0
    },
    "total_mnt_hours": {
      "type": "number",
      "title": "Total de horas MNT",
      "default": 0
    },
    "color": {
      "type": "string",
      "title": "Cor",
      "description": "Texto livre. Ex: Branca e vermelha"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "in_maintenance",
        "grounded"
      ],
      "default": "available",
      "title": "Status"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected"
      ],
      "default": "pending",
      "title": "Status de aprova\u00e7\u00e3o"
    },
    "approval_log": {
      "type": "string",
      "title": "Log de aprova\u00e7\u00e3o (JSON)"
    }
  },
  "required": [
    "registration",
    "model"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}