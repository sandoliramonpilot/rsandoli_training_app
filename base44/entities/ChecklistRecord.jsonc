{
  "name": "ChecklistRecord",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "start_time": {
      "type": "string",
      "title": "Hora inicial (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "title": "Hora final (HH:MM)"
    },
    "aircraft_id": {
      "type": "string",
      "title": "Aeronave"
    },
    "aircraft_registration": {
      "type": "string",
      "title": "Matr\u00edcula (snapshot)"
    },
    "horimeter_initial": {
      "type": "number",
      "title": "Hor\u00edmetro inicial"
    },
    "fuel_initial": {
      "type": "number",
      "title": "Combust\u00edvel inicial"
    },
    "pax_count": {
      "type": "integer",
      "title": "Quantidade de passageiros"
    },
    "pic_name": {
      "type": "string",
      "title": "Piloto em Comando"
    },
    "pic_canac": {
      "type": "string",
      "title": "CANAC do Piloto em Comando"
    },
    "sic_name": {
      "type": "string",
      "title": "Copiloto"
    },
    "sic_canac": {
      "type": "string",
      "title": "CANAC do Copiloto"
    },
    "mission_type": {
      "type": "string",
      "enum": [
        "instrucao",
        "treinamento",
        "transporte",
        "aeromedico",
        "seguranca_publica",
        "patrulhamento",
        "sar",
        "fiscalizacao",
        "outro"
      ],
      "default": "instrucao",
      "title": "Natureza da miss\u00e3o"
    },
    "executed_by": {
      "type": "string",
      "title": "Usu\u00e1rio executante"
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time",
      "title": "Data e hora da finaliza\u00e7\u00e3o"
    },
    "finalized_by": {
      "type": "string",
      "title": "Usu\u00e1rio que finalizou"
    },
    "phases_progress": {
      "type": "string",
      "title": "Progresso das fases (JSON)"
    },
    "justification": {
      "type": "string",
      "title": "Justificativa de itens pendentes"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "pending_items",
        "no_go"
      ],
      "default": "ok",
      "title": "Status final"
    },
    "duration_minutes": {
      "type": "integer",
      "title": "Tempo de execu\u00e7\u00e3o (minutos)"
    },
    "favorite": {
      "type": "boolean",
      "default": false,
      "title": "Favorito"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o",
      "maxLength": 1000
    }
  },
  "required": [
    "date",
    "aircraft_id",
    "pic_name"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}