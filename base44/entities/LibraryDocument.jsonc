{
  "name": "LibraryDocument",
  "type": "object",
  "properties": {
    "aircraftProfile": {
      "type": "string",
      "enum": [
        "AW119",
        "H125",
        "shared"
      ],
      "default": "AW119",
      "title": "Perfil da aeronave"
    },
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "category": {
      "type": "string",
      "title": "Categoria"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "keyword": {
      "type": "string",
      "title": "Palavra-chave"
    },
    "tags": {
      "type": "string",
      "title": "Tags (separadas por v\u00edrgula)"
    },
    "doc_number": {
      "type": "string",
      "title": "N\u00famero ou c\u00f3digo do documento"
    },
    "revision_number": {
      "type": "string",
      "title": "N\u00famero da revis\u00e3o"
    },
    "revision_date": {
      "type": "string",
      "format": "date",
      "title": "Data da revis\u00e3o"
    },
    "publish_date": {
      "type": "string",
      "format": "date",
      "title": "Data de publica\u00e7\u00e3o"
    },
    "validity_date": {
      "type": "string",
      "format": "date",
      "title": "Data de validade"
    },
    "aircraft_id": {
      "type": "string",
      "title": "ID da aeronave relacionada"
    },
    "aircraft_registration": {
      "type": "string",
      "title": "Matr\u00edcula da aeronave (snapshot)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "archived",
        "review"
      ],
      "default": "active",
      "title": "Status do documento"
    },
    "file_uri": {
      "type": "string",
      "title": "URI do arquivo privado (vers\u00e3o vigente)"
    },
    "file_name": {
      "type": "string",
      "title": "Nome do arquivo"
    },
    "file_size": {
      "type": "number",
      "title": "Tamanho do arquivo (bytes)"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Usu\u00e1rio respons\u00e1vel pelo upload"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time",
      "title": "Data e hora do upload"
    },
    "versions": {
      "type": "string",
      "title": "Hist\u00f3rico de vers\u00f5es (JSON)"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "approved_with_notes",
        "rejected"
      ],
      "default": "pending_review",
      "title": "Status de aprova\u00e7\u00e3o"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Revisado por"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Data e hora da revis\u00e3o"
    },
    "review_decision": {
      "type": "string",
      "title": "Decis\u00e3o da revis\u00e3o"
    },
    "review_justification": {
      "type": "string",
      "title": "Justificativa / ressalvas"
    },
    "approval_log": {
      "type": "string",
      "title": "Log de aprova\u00e7\u00e3o (JSON)"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}