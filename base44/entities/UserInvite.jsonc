{
  "name": "UserInvite",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "title": "E-mail do convidado"
    },
    "full_name": {
      "type": "string",
      "title": "Nome completo"
    },
    "login": {
      "type": "string",
      "title": "Login pretendido"
    },
    "access_level": {
      "type": "string",
      "title": "N\u00edvel de acesso pretendido"
    },
    "aircraft_profiles": {
      "type": "string",
      "title": "Perfis de aeronave autorizados",
      "description": "JSON array: [\"AW119\"], [\"H125\"], ou [\"AW119\",\"H125\"]"
    },
    "registration": {
      "type": "string",
      "title": "Matr\u00edcula"
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "unit": {
      "type": "string",
      "title": "Unidade / setor"
    },
    "job_title": {
      "type": "string",
      "title": "Fun\u00e7\u00e3o / cargo"
    },
    "custom_permissions": {
      "type": "string",
      "title": "Permiss\u00f5es personalizadas (JSON)"
    },
    "admin_notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es administrativas"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "cancelled"
      ],
      "default": "pending",
      "title": "Status do convite"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected"
      ],
      "default": "approved",
      "title": "Status de aprova\u00e7\u00e3o do convite"
    },
    "invited_by_user_id": {
      "type": "string",
      "title": "Convidado por"
    },
    "invited_by_name": {
      "type": "string",
      "title": "Nome de quem convidou"
    },
    "created_at": {
      "type": "string",
      "title": "Data do convite"
    },
    "accepted_at": {
      "type": "string",
      "title": "Data de aceite"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o",
      "maxLength": 1000
    }
  },
  "required": [
    "email",
    "access_level"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.custom_permissions": "Custon permissions"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.custom_permissions": "Custon permissions"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.custom_permissions": "Custon permissions"
          }
        }
      ]
    }
  }
}