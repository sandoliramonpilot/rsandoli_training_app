{
  "name": "TrainingCompletion",
  "type": "object",
  "properties": {
    "aircraftProfile": {
      "type": "string",
      "enum": [
        "AW119",
        "H125",
        "shared"
      ],
      "default": "AW119",
      "title": "Perfil da aeronave"
    },
    "pilot_id": {
      "type": "string",
      "title": "ID do piloto"
    },
    "pilot_name": {
      "type": "string",
      "title": "Nome do piloto (snapshot)"
    },
    "training_document_id": {
      "type": "string",
      "title": "ID do documento de treinamento"
    },
    "training_title": {
      "type": "string",
      "title": "T\u00edtulo do treinamento (snapshot)"
    },
    "discipline": {
      "type": "string",
      "title": "Disciplina"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending",
      "title": "Status da conclus\u00e3o"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Data de conclus\u00e3o"
    },
    "score": {
      "type": "number",
      "title": "Aproveitamento (%)"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "pilot_id",
    "training_document_id",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}